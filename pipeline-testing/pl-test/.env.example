# AWS
AWS_REGION=us-east-1
S3_BUCKET_NAME=widhs-pipeline-test-files
S3_TEST_FILE_PREFIX=test-files/

# Raw Staging DB
RAW_STAGING_DB_HOST=your-rds-host.amazonaws.com
RAW_STAGING_DB_PORT=1433
RAW_STAGING_DB_NAME=RawStagingDB
RAW_STAGING_DB_USER=your_user
RAW_STAGING_DB_PASSWORD=your_password

# Staged/Mapped DB
STAGED_DB_HOST=your-rds-host.amazonaws.com
STAGED_DB_PORT=1433
STAGED_DB_NAME=StagedDB
STAGED_DB_USER=your_user
STAGED_DB_PASSWORD=your_password

# Carity (Blue Compass) DB
CARITY_DB_HOST=your-rds-host.amazonaws.com
CARITY_DB_PORT=1433
CARITY_DB_NAME=CarityDB
CARITY_DB_USER=your_user
CARITY_DB_PASSWORD=your_password

# Test Verification DB
VERIFICATION_DB_HOST=your-rds-host.amazonaws.com
VERIFICATION_DB_PORT=1433
VERIFICATION_DB_NAME=TestVerificationDB
VERIFICATION_DB_USER=your_user
VERIFICATION_DB_PASSWORD=your_password

# Data Isolation
MCD_ID_RANGE_START=000000000000001
MCD_ID_RANGE_END=000000000099999

# Vocabulary files path (defaults to ../vocab relative to pipeline_tester)
# VOCAB_PATH=/path/to/vocab
